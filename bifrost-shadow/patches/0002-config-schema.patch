+// TestValidateConfigSchema_ShadowCoversEverySetting keeps the schema and shadow.Config in step.
+func TestValidateConfigSchema_ShadowCoversEverySetting(t *testing.T) {
+	var schema struct {
+		Properties struct {
+			Plugins struct {
+				Items struct {
+					AllOf []struct {
+						If struct {
+							Properties struct {
+								Name struct {
+									Const string `json:"const"`
+								} `json:"name"`
+							} `json:"properties"`
+						} `json:"if"`
+						Then struct {
+							Properties struct {
+								Config struct {
+									Properties map[string]struct {
+										Properties map[string]json.RawMessage `json:"properties"`
+									} `json:"properties"`
+								} `json:"config"`
+							} `json:"properties"`
+						} `json:"then"`
+					} `json:"allOf"`
+				} `json:"items"`
+			} `json:"plugins"`
+		} `json:"properties"`
+	}
+	if err := json.Unmarshal(loadLocalSchema(t), &schema); err != nil {
+		t.Fatalf("failed to parse config.schema.json: %v", err)
+	}
+	var declared map[string]struct {
+		Properties map[string]json.RawMessage `json:"properties"`
+	}
+	for _, entry := range schema.Properties.Plugins.Items.AllOf {
+		if entry.If.Properties.Name.Const == shadow.PluginName {
+			declared = entry.Then.Properties.Config.Properties
+		}
+	}
+	if declared == nil {
+		t.Fatal("config.schema.json has no plugins entry for shadow")
+	}
+	checkFields := func(scope string, goType reflect.Type, schemaProps map[string]json.RawMessage) {
+		fields := map[string]bool{}
+		for i := range goType.NumField() {
+			name, _, _ := strings.Cut(goType.Field(i).Tag.Get("json"), ",")
+			if name == "" || name == "-" {
+				continue
+			}
+			fields[name] = true
+			if _, ok := schemaProps[name]; !ok {
+				t.Errorf("%s field %q is missing from config.schema.json", scope, name)
+			}
+		}
+		for name := range schemaProps {
+			if !fields[name] {
+				t.Errorf("config.schema.json declares %s.%s, which the plugin does not take", scope, name)
+			}
+		}
+	}
+	top := map[string]json.RawMessage{}
+	for name := range declared {
+		top[name] = nil
+	}
+	checkFields("shadow.Config", reflect.TypeOf(shadow.Config{}), top)
+	checkFields("shadow.Thresholds", reflect.TypeOf(shadow.Thresholds{}), declared["thresholds"].Properties)
+	checkFields("shadow.JudgeConfig", reflect.TypeOf(shadow.JudgeConfig{}), declared["judge"].Properties)
+	checkFields("shadow.EmbeddingConfig", reflect.TypeOf(shadow.EmbeddingConfig{}), declared["embedding"].Properties)
+	checkFields("shadow.CanaryConfig", reflect.TypeOf(shadow.CanaryConfig{}), declared["canary"].Properties)
+}
