+// shadowPluginConfig wraps a shadow plugin config object in a full config document.
+func shadowPluginConfig(config string) []byte {
+	return []byte(`{"plugins": [{"enabled": true, "name": "shadow", "config": ` + config + `}]}`)
+}
+
+func TestValidateConfigSchema_ShadowPlugin(t *testing.T) {
+	schemaData := loadLocalSchema(t)
+	valid := `{
+		"sample_rate": 0.25,
+		"allow_force_header": true,
+		"experiments": [{
+			"name": "cost-down",
+			"source": {"provider": "openai", "model": "gpt-4o"},
+			"candidates": [{"provider": "openai", "model": "gpt-4o-mini"}],
+			"sample_rate": 0.5
+		}],
+		"judge": {"provider": "openai", "model": "gpt-4o", "sample_rate": 0.5},
+		"embedding": {"provider": "openai", "model": "text-embedding-3-small"},
+		"max_concurrency": 4, "queue_size": 256, "timeout_seconds": 30,
+		"daily_budget_usd": 10, "virtual_keys": ["vk-prod"], "max_records": 1000,
+		"store_payloads": false, "max_payload_chars": 4000, "persist_path": "shadow.jsonl",
+		"pricing": {"openai/gpt-4o-mini": {"input_per_million": 0.15, "output_per_million": 0.6}},
+		"thresholds": {"min_samples": 50, "min_agreement": 0.95, "max_error_rate": 0.02,
+			"quality_tolerance": 0.5, "lexical_threshold": 0.5, "semantic_threshold": 0.9,
+			"max_judge_error_rate": 0.2},
+		"quality_fallback": "lexical",
+		"canary": {"auto_rollback": true, "min_requests": 50, "max_error_rate": 0.02, "max_latency_ratio": 2.5, "rollback_on_not_ready": false}
+	}`
+	if err := ValidateConfigSchema(shadowPluginConfig(valid), schemaData); err != nil {
+		t.Fatalf("expected valid shadow config to pass, got: %v", err)
+	}
+	wildcard := `{"experiments": [{"source": {"model": "*"}, "candidates": [{"provider": "anthropic", "model": "claude-haiku"}]}]}`
+	if err := ValidateConfigSchema(shadowPluginConfig(wildcard), schemaData); err != nil {
+		t.Fatalf("expected wildcard source to pass, got: %v", err)
+	}
+
+	invalid := map[string]string{
+		"missing config":        `null`,
+		"missing experiments":   `{"sample_rate": 0.1}`,
+		"empty experiments":     `{"experiments": []}`,
+		"no candidates":         `{"experiments": [{"source": {"model": "gpt-4o"}, "candidates": []}]}`,
+		"candidate needs model": `{"experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai"}]}]}`,
+		"sample rate above 1":   `{"sample_rate": 1.5, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"zero sample rate":      `{"sample_rate": 0, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"unknown field":         `{"sampel_rate": 0.1, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"judge needs model":     `{"judge": {"provider": "openai"}, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"negative price":        `{"pricing": {"m": {"input_per_million": -1}}, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"agreement above 1":     `{"thresholds": {"min_agreement": 2}, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"force header not bool": `{"allow_force_header": "yes", "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"unknown fallback":      `{"quality_fallback": "structural", "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+		"canary typo":           `{"canary": {"auto_rolback": true}, "experiments": [{"source": {"model": "gpt-4o"}, "candidates": [{"provider": "openai", "model": "m"}]}]}`,
+	}
+	for name, config := range invalid {
+		if err := ValidateConfigSchema(shadowPluginConfig(config), schemaData); err == nil {
+			t.Errorf("%s: expected schema validation to fail", name)
+		}
+	}
+}
