+// wireShadowPlugin gives the shadow plugin the client calls it issues, a
+// pricing function backed by the model catalog (pricing overrides included),
+// and the rollback and ramp steps its canary guard takes.
+func (s *BifrostHTTPServer) wireShadowPlugin(p *shadow.Plugin) {
+	var price shadow.PriceFunc
+	if s.Config.ModelCatalog != nil {
+		catalog := s.Config.ModelCatalog
+		price = func(usage *schemas.BifrostLLMUsage, provider schemas.ModelProvider, model string, requestType schemas.RequestType) float64 {
+			return catalog.CalculateCostForUsage(usage, provider, model, requestType, nil)
+		}
+	}
+	p.SetExecutors(s.Client.ChatCompletionRequest, s.Client.EmbeddingRequest, price)
+	rules := s.shadowRoutingRules()
+	p.SetRollbackHook(handlers.NewShadowRollbackHook(p, rules))
+	p.SetRampHook(handlers.NewShadowRampHook(p, rules))
+}
+
+// shadowRoutingRules is the routing-rule store shadow promotion writes to, or
+// nil when there is no config store.
+func (s *BifrostHTTPServer) shadowRoutingRules() handlers.ShadowRoutingRules {
+	if s.Config == nil || s.Config.ConfigStore == nil {
+		return nil
+	}
+	return handlers.NewShadowRoutingRules(s.Config.ConfigStore, s)
+}
